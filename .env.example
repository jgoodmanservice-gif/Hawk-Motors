# ---- Database (PostgreSQL) ----
# Local example. Replace with your hosted Postgres (Supabase, Neon, RDS, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hawkmotors?schema=public"

# ---- Auth (NextAuth) ----
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Default admin seeded into the DB (change after first login)
ADMIN_EMAIL="admin@hawkmotors.co.uk"
ADMIN_PASSWORD="ChangeMe123!"

# ---- Site / contact (also editable in the admin Settings) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE="07514552586"
NEXT_PUBLIC_WHATSAPP="447514552586"
NEXT_PUBLIC_EMAIL="enquiries@hawkmotors.co.uk"

# ---- Email notifications (SMTP) — optional ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hawk Motors <enquiries@hawkmotors.co.uk>"
ENQUIRY_NOTIFY_TO="enquiries@hawkmotors.co.uk"
